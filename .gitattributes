# Normalise to LF in the repository. The game reads either, but without this Git
# rewrites every line ending on a Windows checkout and the next diff is the whole file.
* text=auto eol=lf

*.lua   text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
mod.info text eol=lf

*.png binary
